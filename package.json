{
  "name": "swiftstyle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SwiftStyle : widget de recommandation de taille pour les fiches produit des marques e-commerce de mode.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run prepare:mediapipe && npm run build:widget",
    "dev": "next dev --port 3000",
    "prebuild": "npm run prepare:mediapipe && npm run build:widget",
    "build": "next build",
    "build:widget": "vite build --config vite.widget.config.ts",
    "prepare:mediapipe": "node scripts/prepare-mediapipe.mjs",
    "start": "next start --port 3000",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.162.0"
  }
}
