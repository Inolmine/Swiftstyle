# Copier en .env sur le serveur : docker compose le lit. Ne jamais versionner .env.

# Nom de domaine de l'API. Son DNS (enregistrement A ou AAAA) doit pointer vers le serveur.
API_DOMAIN=api.example.com

# Sites autorisés à appeler l'API depuis le navigateur, séparés par des virgules : le site SwiftStyle, puis les sites
# des marques qui ont installé le widget. Un site absent n'est pas bloqué : son widget mesure dans le navigateur.
# « * » autorise tous les sites.
ALLOWED_ORIGINS=https://swiftstyle.jesololido2004.workers.dev

# Nombre de processus : environ un par cœur du serveur ; chacun garde MediaPipe en mémoire (300 à 500 Mo).
WEB_CONCURRENCY=1

# Requêtes par minute et par adresse IP (0 : sans limite). Le cadrage en direct en envoie environ 3 par seconde.
RATE_LIMIT_MEASURE=30
RATE_LIMIT_POSE=600
